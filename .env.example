# Scout — GenAI Fund Outreach Prototype

# === X API v2 Credentials (BYOK) ===
# Get these from https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# === LLM Provider (choose one) ===
# Options: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# === App Settings ===
# Encryption key for storing API keys in DB (auto-generated if empty)
ENCRYPTION_KEY=

# Default mode: sandbox | live
DEFAULT_MODE=sandbox
